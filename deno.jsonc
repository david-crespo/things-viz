{
  "unstable": [
    "raw-imports"
  ],
  "tasks": {
    // The narrow test permissions guarantee tests can't touch a real Things DB (see
    // test/cli.ts for the subprocess side). Don't widen them to fix a failing test.
    "test": "deno test --no-prompt --allow-read=test/.tmp --allow-write=test/.tmp --allow-run=deno --allow-env=PATH,HOME,TZ",
    "verify:real-schema": "deno run --allow-env=THINGSDB,HOME --allow-read --allow-write=test/.tmp tools/verify-fixture-schema.ts"
  },
  "fmt": {
    "lineWidth": 92,
    "semiColons": false,
    "singleQuote": true
  },
  "imports": {
    "@std/dotenv": "jsr:@std/dotenv@^0.225.6",
    "@std/fs": "jsr:@std/fs@^1.0.8",
    "zod": "npm:zod@^4.1.12",
    "dayjs": "npm:dayjs@^1.11.18",
    "memoize": "npm:memoize@^10.1.0",
    "@cliffy/command": "jsr:@cliffy/command@1.0.0-rc.8",
    "@cliffy/table": "jsr:@cliffy/table@1.0.0-rc.8",
    "ts-pattern": "npm:ts-pattern@^5.9.0"
  }
}
